<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>online.charstarearth.estomago</string>

  <!-- WP-04（JFA-E02）：wrapper 式——秘密经 start.sh source 受保护 env 文件，
       零秘密落 plist；KeepAlive 拉回时 env 由 wrapper 保证齐全 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/Data/estomago-secrets/start.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>StandardOutPath</key>
  <string>__LOG_ROOT__/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_ROOT__/launchd.err.log</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>ProcessType</key>
  <string>Adaptive</string>
</dict>
</plist>

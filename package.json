{
  "name": "estomago",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "estómago · 自建聊天宿主（现行规范 ESTOMAGO_OR_SELF_HOLD：OpenRouter 主接入+自主 hold+1h 缓存；进度见 docs/specs/IMPLEMENTATION_MAP.md，验收以 ACCEPTANCE.json 逐项为准）",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "status": "node scripts/stop.mjs --status",
    "test": "node scripts/run-tests.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "install-launchagent": "node scripts/install-launchagent.mjs",
    "typecheck": "tsc --noEmit",
    "build:web": "npm --prefix apps/web/react run build",
    "typecheck:web": "npm --prefix apps/web/react run typecheck"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:estomago-mariposa:design:episode-apply:v1",
  "title": "PROPOSED episode.apply input; semantic/source/ACL checks are server-side",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "action": {
      "type": "string",
      "enum": [
        "start",
        "continue",
        "pause",
        "close",
        "correct"
      ]
    },
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "source_selections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "terminal_source_ref": {
      "$ref": "#/$defs/sourceRef"
    },
    "decision_source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRef"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "tracking_requested",
        "same_episode",
        "waiting",
        "explicit_completion",
        "goal_resolved",
        "episode_concluded",
        "boundary_error"
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 500
    },
    "corrected_state": {
      "type": "string",
      "enum": [
        "OPEN",
        "QUIESCENT",
        "CLOSED"
      ]
    }
  },
  "required": [
    "operation_id",
    "scope_id",
    "action",
    "reason_code"
  ],
  "additionalProperties": false,
  "$defs": {
    "member": {
      "type": "object",
      "properties": {
        "source_message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "source_message_id",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "minItems": 1,
          "maxItems": 200
        },
        "start_char_offset": {
          "type": "integer",
          "minimum": 0
        },
        "end_char_offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "conversation_id",
        "members"
      ],
      "additionalProperties": false
    },
    "sourceRef": {
      "type": "object",
      "properties": {
        "source_message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "char_offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "source_message_id",
        "content_hash"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "start"
          }
        }
      },
      "then": {
        "required": [
          "label",
          "source_selections"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "episode_id"
              ]
            },
            {
              "required": [
                "expected_revision"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "episode_id",
          "expected_revision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "continue"
          }
        }
      },
      "then": {
        "required": [
          "source_selections"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "close"
          }
        }
      },
      "then": {
        "required": [
          "terminal_source_ref",
          "decision_source_refs"
        ],
        "properties": {
          "reason_code": {
            "enum": [
              "explicit_completion",
              "goal_resolved",
              "episode_concluded"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "correct"
          }
        }
      },
      "then": {
        "required": [
          "corrected_state",
          "note",
          "decision_source_refs"
        ],
        "properties": {
          "reason_code": {
            "const": "boundary_error"
          },
          "note": {
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "correct"
          },
          "corrected_state": {
            "const": "CLOSED"
          }
        },
        "required": [
          "corrected_state"
        ]
      },
      "then": {
        "required": [
          "terminal_source_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "start"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "enum": [
              "tracking_requested"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "corrected_state"
              ]
            },
            {
              "required": [
                "decision_source_refs"
              ]
            },
            {
              "required": [
                "episode_id"
              ]
            },
            {
              "required": [
                "expected_revision"
              ]
            },
            {
              "required": [
                "note"
              ]
            },
            {
              "required": [
                "terminal_source_ref"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "continue"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "enum": [
              "same_episode"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "corrected_state"
              ]
            },
            {
              "required": [
                "decision_source_refs"
              ]
            },
            {
              "required": [
                "label"
              ]
            },
            {
              "required": [
                "note"
              ]
            },
            {
              "required": [
                "terminal_source_ref"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "pause"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "enum": [
              "waiting"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "corrected_state"
              ]
            },
            {
              "required": [
                "decision_source_refs"
              ]
            },
            {
              "required": [
                "label"
              ]
            },
            {
              "required": [
                "note"
              ]
            },
            {
              "required": [
                "source_selections"
              ]
            },
            {
              "required": [
                "terminal_source_ref"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "close"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "enum": [
              "explicit_completion",
              "goal_resolved",
              "episode_concluded"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "corrected_state"
              ]
            },
            {
              "required": [
                "label"
              ]
            },
            {
              "required": [
                "note"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "correct"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "enum": [
              "boundary_error"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "label"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "correct"
          },
          "corrected_state": {
            "enum": [
              "OPEN",
              "QUIESCENT"
            ]
          }
        },
        "required": [
          "corrected_state"
        ]
      },
      "then": {
        "not": {
          "required": [
            "terminal_source_ref"
          ]
        }
      }
    }
  ]
}
